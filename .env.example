# ZTools Docs — environment variables.
#
# Copy this file to `.env` (which is gitignored) and fill in the values
# for whichever integrations you want active locally. Each is OPTIONAL —
# leaving a key empty means that tool's script never ships, build still
# succeeds, the docs site works fully.
#
# In CI (.github/workflows/deploy.yml), the same keys are injected from
# GitHub Actions repo secrets. Add each key as a secret in:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
#
# Privacy disclosure for what each tool tracks:
#   https://ztools-docs.zaions.com/docs/privacy

# ----------------------------------------------------------------------------
# Google Analytics 4
# Get from: analytics.google.com → Admin → Create property → Web data stream
# Format: G-XXXXXXXXXX
# ----------------------------------------------------------------------------
GA_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# Microsoft Clarity (heatmaps + anonymized session recordings)
# Get from: clarity.microsoft.com → New project → installation snippet
# Format: 10-character alphanumeric ID
# ----------------------------------------------------------------------------
CLARITY_PROJECT_ID=

# ----------------------------------------------------------------------------
# Amplitude (product analytics)
# Get from: amplitude.com → Settings → Projects → API Key
# Format: 32-character alphanumeric
# ----------------------------------------------------------------------------
AMPLITUDE_API_KEY=

# ----------------------------------------------------------------------------
# Sentry (frontend error monitoring)
# Get from: sentry.io → Settings → Projects → Client Keys (DSN)
# Format: https://abc123@o000000.ingest.sentry.io/0000000
# ----------------------------------------------------------------------------
SENTRY_DSN=
