# Dependencies
/node_modules
.pnp/
.pnp.*

# Build output
/build
.docusaurus/
.cache-loader/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# Lock files for other package managers (we use yarn)
package-lock.json
pnpm-lock.yaml

# Project-record (per global standards)
project-record-ignore/
*.ignore.*

# Yarn 4 (Berry) — ignore cache/state, allow patches/plugins/releases/sdks/versions
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
