{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": [
        "./*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ]
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "plugins",
    "src",
    "scripts"
  ],
  "exclude": [
    ".docusaurus",
    "build",
    "node_modules"
  ]
}
