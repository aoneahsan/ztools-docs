// `yarn typecheck` runs this; `docusaurus start/build` do not read it.
// It includes plugins/ and src/ so the site-pages plugin and every component are checked, not only the config.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets baseUrl relative to its own folder; restating it here makes @site/* resolve from this one.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "types": ["node", "@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "paths": {"@site/*": ["./*"]}
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "plugins", "src", "scripts"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
